# Порт мини-бэкенда
PORT=3100

# Пароль админки (страница /admin.html) — ОБЯЗАТЕЛЬНО сменить!
ADMIN_PASSWORD=change-me

# Почта для уведомлений (необязательно: без неё заявки копятся в SQLite,
# а текст писем виден в консоли сервера).
# Для Gmail нужен ПАРОЛЬ ПРИЛОЖЕНИЙ (не обычный пароль!),
# создаётся в Google-аккаунте → Безопасность → Пароли приложений.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=vitrina.orders.knigi@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# SMTP_FROM=vitrina.orders.knigi@gmail.com
# NOTIFY_TO=you@example.com

# --- ЮKassa (необязательно: без ключей кнопки «Купить» сохраняют заявку) ---
# YOOKASSA_SHOP_ID=123456
# YOOKASSA_SECRET=test_xxxxxxxxxxxxxxxx
# YOOKASSA_RETURN_URL=http://localhost:3100/?paid=1
